# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production builds & packages
dist/
build/
Output/
client/dist/
launcher.zip
*.exe
*.msi

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.spec

# Environment & credentials — NEVER commit these
.env
.env.local
.env.*.local
*.pfx
*.p12
*.jks
*.keystore
keystore.properties
android/keystore.properties
cert/*.pfx
cert/*.cer

# Runtime data, databases & caches (user data must never be committed)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
server/data/
data/
backups/
logs/
*.log

# Vite temporary files & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
vite.config.js.timestamp-*.mjs
client/vite.config.js.timestamp-*.mjs

# OS & Editor temporary files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
*.suo
*.user

# Android artifacts & build
.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/.aistudio/
android/*.iml
android/app/*.iml
*.apk
*.aab

# Test / tooling caches
coverage/
.nyc_output/
.eslintcache

# Vendored third-party web client (GPL) — fetched on demand, see docs/THIRD_PARTY.md
# server/public/jellyfin/
