# ══════════════════════════════════════════════════════════════════════════
# ARN Stream — server environment (copy to `server/.env`, never commit it)
# ══════════════════════════════════════════════════════════════════════════

# HTTP port of the media server (default 8096)
PORT=8096

# JWT signing key. Leave empty to auto-generate and store it in the database.
# Set it (>= 32 chars) to keep sessions valid across database resets.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Token lifetime (jsonwebtoken syntax). Shorter is safer; the web client
# re-authenticates silently while the cookie is still valid.
JWT_TTL=30d

# Set to 1 only when running behind a reverse proxy you control
# (nginx/Traefik). Enabling it without a proxy lets clients spoof their IP.
TRUST_PROXY=false

# Comma-separated list of extra origins allowed to call the API from a browser.
# Same-host and localhost origins are always allowed.
# CORS_ORIGINS=https://media.example.com,https://app.example.com

# TheMovieDB API key used by the metadata fetcher (optional)
TMDB_API_KEY=

# Disable the anti-forensic licence persistence layers for full transparency
# (only %APPDATA% state is kept). Set to false if you care about AV false positives.
ARN_LICENSE_STEALTH=true
