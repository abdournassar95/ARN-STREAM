<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Dark rounded badge base -->
    <path
        android:pathData="M 48,6 C 24.8,6 6,24.8 6,48 C 6,71.2 24.8,90 48,90 C 71.2,90 90,71.2 90,48 C 90,24.8 71.2,6 48,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="6"
                android:endX="48"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#1E293B" />
                <item android:offset="1.0" android:color="#090D16" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer glowing rim -->
    <path
        android:pathData="M 48,8 C 25.9,8 8,25.9 8,48 C 8,70.1 25.9,88 48,88 C 70.1,88 88,70.1 88,48 C 88,25.9 70.1,8 48,8 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#3310B981" />

    <!-- Ambient Neon Ring -->
    <path
        android:pathData="M 28,48 A 20,20 0 1,1 68,48"
        android:strokeWidth="3"
        android:strokeColor="#E50914"
        android:strokeLineCap="round" />

    <!-- Spiritual Emerald Crescent -->
    <path
        android:pathData="M 68,48 A 20,20 0 0,1 32,60"
        android:strokeWidth="3"
        android:strokeColor="#10B981"
        android:strokeLineCap="round" />

    <!-- Central 3D Play Polygon -->
    <path
        android:pathData="M 40,32 L 64,48 L 40,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="32"
                android:endX="64"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3B47" />
                <item android:offset="0.5" android:color="#E50914" />
                <item android:offset="1.0" android:color="#991B1B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play reflection -->
    <path
        android:pathData="M 41,35 L 56,45 L 41,50 Z"
        android:fillColor="#50FFFFFF" />

    <!-- Gold Accent Star -->
    <path
        android:pathData="M 48,20 L 50,23 L 53,25 L 50,27 L 48,30 L 46,27 L 43,25 L 46,23 Z"
        android:fillColor="#F59E0B" />
</vector>
