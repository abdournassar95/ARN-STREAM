# ══════════════════════════════════════════════════════════════════════════
# ARN Stream — Android build configuration
# ══════════════════════════════════════════════════════════════════════════
#
# ⚠️ IMPORTANT: every uncommented `KEY=value` line in this file (and in
# `android/.env`) is injected by the Secrets Gradle Plugin as a *public
# BuildConfig constant inside the APK*. Never put passwords or signing keys
# here — they would be extractable from the shipped app.
#
# ── Release signing (recommended: android/keystore.properties, gitignored) ─
# Create android/keystore.properties with:
#   KEYSTORE_PATH=/absolute/path/to/release.jks
#   STORE_PASSWORD=********
#   KEY_ALIAS=upload
#   KEY_PASSWORD=********
#
# In CI the same values come from GitHub Secrets:
#   ANDROID_KEYSTORE_BASE64, ANDROID_STORE_PASSWORD,
#   ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
# and are passed to Gradle as environment variables (KEYSTORE_PATH,
# STORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD) — see .github/workflows/ci.yml.
#
# Without those, `assembleRelease` still succeeds but produces an
# UNSIGNED release APK, and `assembleDebug` uses the standard debug key.
#
# ── Optional runtime keys ─────────────────────────────────────────────────
# Uncomment only if the app actually calls the Gemini API.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
